rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Habits collection
    match /habits/{habitId} {
      allow read, write: if true;
    }
    
    // Goals collection
    match /goals/{goalId} {
      allow read, write: if true;
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    
    // Events collection
    match /events/{eventId} {
      allow read, write: if true;
    }
  }
}
